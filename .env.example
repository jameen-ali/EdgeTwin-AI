# EdgeTwin AI Environment Configuration Template
# Copy this file to .env and customize for your environment.
# DO NOT commit .env containing production secrets to version control.

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="EdgeTwin AI Backend"

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Connection (PostgreSQL for standard deployment, SQLite for lightweight testing)
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Logging
LOG_LEVEL=INFO

# MQTT Broker (Path A: HiveMQ Cloud, Path B: Local Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=edgetwin-ingest
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30

# MLflow Tracking URI
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Authentication (Reserved for T-038)
JWT_SECRET=
